COPY src/ ./src/

RUN poetry build --format wheel

FROM python:3.11.6-slim-bookworm AS runtime

WORKDIR /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOST=0.0.0.0 \
    PORT=8080

COPY --from=build /app/dist/ ./dist/

RUN python -m pip install --isolated --no-index --no-deps dist/*.whl dist/vendor/*.whl

EXPOSE 8080

CMD ["python", "-m", "counter_backend"]
EOF
